# ==============================================================================
# Seamus Configuration Template
# Copy this file to `.env` and fill in your values:
#   cp .env.template .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Pydantic Logfire Observability
# ------------------------------------------------------------------------------
# Project authentication token from your Logfire dashboard (https://logfire.pydantic.dev).
# If unset, Logfire operates in safe local mode without sending remote traces.
LOGFIRE_TOKEN=

# Service name displayed in the Logfire dashboard (default: seamus)
LOGFIRE_SERVICE_NAME=seamus

# Control trace delivery: 'if-token-present', 'true', or 'false'
# Default: if-token-present
LOGFIRE_SEND_TO_LOGFIRE=if-token-present

# Environment tag for filtering traces in Logfire (e.g. development, staging, production)
LOGFIRE_ENVIRONMENT=development

# LangChain / LangGraph native OpenTelemetry integration (enabled by default)
LANGSMITH_OTEL_ENABLED=true
LANGSMITH_OTEL_ONLY=true
LANGSMITH_TRACING=true

# ------------------------------------------------------------------------------
# Inference & Model Configuration
# ------------------------------------------------------------------------------
# API key for model inference (e.g., OpenRouter or OpenAI)
OPENROUTER_API_KEY=

# Inference base URL (default: OpenRouter API)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model identifier for agents and sessions
OPENROUTER_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# Git Persistence (Gitea & PostgreSQL)
# ------------------------------------------------------------------------------
# Gitea internal API URL (for Docker container network use http://gitea:3000; for local dev use http://localhost:3001)
GITEA_URL=http://localhost:3001

# Gitea external Web UI URL accessible from browser
GITEA_EXTERNAL_URL=http://localhost:3001

# Gitea admin/service account credentials
GITEA_ADMIN_USER=seamus
GITEA_ADMIN_PASSWORD=seamus-password-123
GITEA_ADMIN_EMAIL=seamus@seamus.local

# PostgreSQL backing database credentials
POSTGRES_DB=gitea
POSTGRES_USER=gitea
POSTGRES_PASSWORD=gitea

# Local workspace directory for agent/session clones
SEAMUS_WORKSPACE_DIR=.seamus/workspaces

# ------------------------------------------------------------------------------
# OpenSandbox Execution Sandbox
# (Note: Sandbox API authentication is autogenerated and managed by the runtime)
# ------------------------------------------------------------------------------
# OpenSandbox lifecycle server domain (for Docker network use opensandbox:8080; for local dev use localhost:8080)
OPENSANDBOX_DOMAIN=localhost:8080

# OpenSandbox server protocol ('http' or 'https')
OPENSANDBOX_PROTOCOL=http

# Container image used for agent execution sandboxes
OPENSANDBOX_IMAGE=python:3.12-slim

# Operational directory where the Git-tracked session data/ directory is mounted inside the sandbox
OPENSANDBOX_WORKDIR=/workspace

# Default per-command execution timeout in seconds
OPENSANDBOX_TIMEOUT=300

# Sandbox container TTL in seconds
OPENSANDBOX_SANDBOX_TIMEOUT=3600

# ------------------------------------------------------------------------------
# Server Network Settings
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

