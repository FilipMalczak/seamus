FROM ubuntu:24.04

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-minimal \
    python3-pip \
    python3-venv \
    nodejs \
    npm \
    git \
    ca-certificates \
    curl \
    wget \
    jq \
    tree \
    build-essential \
    less \
    procps \
    && rm -rf /var/lib/apt/lists/* \
    && echo '{"image":"seamus-sandbox:latest","base":"ubuntu:24.04","tools":["python3","uv","nodejs","npm","git","curl","wget","jq","tree","build-essential"]}' > /etc/seamus-sandbox.json

COPY Dockerfile.sandbox /etc/seamus-sandbox.dockerfile
